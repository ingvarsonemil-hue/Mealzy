# Mealzy environment variables
# Copy this file to .env and fill in the values

# ── Required ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=        # Your Anthropic (Claude) API key
JWT_SECRET=               # Long random string — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
PRO_TOKEN=                # Secret token for admin endpoints (/api/admin/export)

# ── Stripe (required for reliable Pro activation) ─────────────────────────
STRIPE_SECRET_KEY=        # sk_live_... from Stripe dashboard
STRIPE_WEBHOOK_SECRET=    # whsec_... from Stripe Webhooks → Add endpoint

# ── Optional ──────────────────────────────────────────────────────────────
PORT=3000                 # Render sets this automatically
NODE_ENV=production       # Set to 'production' on Render
APP_URL=https://mealzy.org # Used to construct reset-password URLs
UNSPLASH_ACCESS_KEY=      # Unsplash API key for food photos (optional)
SUPABASE_URL=             # Legacy Supabase — leave blank if not using
SUPABASE_ANON_KEY=        # Legacy Supabase — leave blank if not using
